{
  "version": "1.2.0",
  "note": "标签、箭头、数据表、时间轴状态是图形功能或增强组件，不应计入菜单图表数",
  "count": 19,
  "features": [
    {
      "id": "difference-arrows",
      "name_zh": "差异箭头",
      "description": "对任意两个数据端点标出绝对差/百分比差",
      "fields": [
        "pointA",
        "pointB",
        "mode"
      ],
      "rule": "diff=B-A; pct=(B-A)/abs(A)，A=0时不显示百分比",
      "source_url": "https://www.think-cell.com/en/resources/manual/chartdecorations",
      "web_implementation": "原创 SVG mark + annotations layer",
      "is_chart_type": false
    },
    {
      "id": "cagr-arrows",
      "name_zh": "CAGR 复合增长箭头",
      "description": "起止期间计算复合增长并连接时间点",
      "fields": [
        "start",
        "end",
        "elapsed_years"
      ],
      "rule": "CAGR=(end/start)^(1/years)-1；值必须满足数学定义",
      "source_url": "https://www.think-cell.com/en/resources/manual/chartdecorations",
      "web_implementation": "原创 SVG mark + annotations layer",
      "is_chart_type": false
    },
    {
      "id": "series-cagr-labels",
      "name_zh": "系列 CAGR 标签",
      "description": "同一系列各自增长率",
      "fields": [
        "series",
        "start",
        "end",
        "years"
      ],
      "rule": "仅对连续正值区间计算；零/负需说明不可算",
      "source_url": "https://www.think-cell.com/en/resources/manual/chartdecorations",
      "web_implementation": "原创 SVG mark + annotations layer",
      "is_chart_type": false
    },
    {
      "id": "value-lines",
      "name_zh": "水平/垂直数值线",
      "description": "显示目标、均值、中位和阈值",
      "fields": [
        "axis",
        "value",
        "label"
      ],
      "rule": "目标线与统计中心线应区分",
      "source_url": "https://www.think-cell.com/en/resources/manual/chartdecorations",
      "web_implementation": "原创 SVG mark + annotations layer",
      "is_chart_type": false
    },
    {
      "id": "percentage-indicators",
      "name_zh": "100% 指示器",
      "description": "说明堆积百分比图的总体尺度",
      "fields": [
        "sum",
        "denominator"
      ],
      "rule": "明确分母非空与总量",
      "source_url": "https://www.think-cell.com/en/resources/manual/chartdecorations",
      "web_implementation": "原创 SVG mark + annotations layer",
      "is_chart_type": false
    },
    {
      "id": "series-connectors",
      "name_zh": "系列连接线",
      "description": "相邻类别同系列视觉跟踪",
      "fields": [
        "category",
        "series",
        "value"
      ],
      "rule": "连接只表示趋势/延续，非流量",
      "source_url": "https://www.think-cell.com/en/resources/manual/chartdecorations",
      "web_implementation": "原创 SVG mark + annotations layer",
      "is_chart_type": false
    },
    {
      "id": "universal-connectors",
      "name_zh": "通用连接线",
